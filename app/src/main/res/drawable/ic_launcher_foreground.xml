<?xml version="1.0" encoding="utf-8"?>
<!-- A sticky note drawn as a 3D box (a nod to Notion's cube logo) with a folded corner.
     Gradient #FFC93C → #F5A623 → #E8731A, as in DESIGN.md "Icons". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1"
        android:scaleY="1">
        <!-- Top face: lighter. -->
        <path
            android:fillColor="#FFFFD978"
            android:pathData="M30,38L38,30H78L70,38Z" />
        <!-- Side face: darker. -->
        <path
            android:fillColor="#FFC85E14"
            android:pathData="M70,38L78,30V58L70,66Z" />
        <path android:pathData="M30,38H70V66L58,78H30Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="30"
                    android:startY="38"
                    android:endX="70"
                    android:endY="78">
                    <item android:offset="0" android:color="#FFFFC93C" />
                    <item android:offset="0.5" android:color="#FFF5A623" />
                    <item android:offset="1" android:color="#FFE8731A" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- The folded corner: the note's pale back side. -->
        <path
            android:fillColor="#FFFFEBB5"
            android:pathData="M58,66H70L58,78Z" />
    </group>
</vector>
