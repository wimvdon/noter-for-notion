<?xml version="1.0" encoding="utf-8"?>
<!-- Two stacked notes, after Notion Calendar's logo: a note behind (only its top and left edges
     show) and a note in front with a folded bottom right corner and two white lines of text.
     Gradients run from top left to bottom right, #FFC94D → #F5A623 → #E8710A, on the white
     background. Drawn on 22..90 and scaled to 75% (28.5..79.5), well inside the 66dp safe zone. See DESIGN.md. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled to 75% around the middle (the drawing is centred on 56,56), so it keeps some
         padding inside the launcher's circle or squircle mask. -->
    <group
        android:pivotX="56"
        android:pivotY="56"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="-2"
        android:translateY="-2">
        <!-- The note behind. -->
        <path android:pathData="M30,22h38a8,8 0,0 1,8 8v38a8,8 0,0 1,-8 8h-38a8,8 0,0 1,-8 -8v-38a8,8 0,0 1,8 -8z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="22"
                    android:startY="22"
                    android:endX="76"
                    android:endY="76">
                    <item android:offset="0" android:color="#FFFFD66E" />
                    <item android:offset="1" android:color="#FFF5A623" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- A white gap around the note in front. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M38.5,28.5h42a9.5,9.5 0,0 1,9.5 9.5v34l-18,18h-33.5a9.5,9.5 0,0 1,-9.5 -9.5v-42.5a9.5,9.5 0,0 1,9.5 -9.5z" />
        <!-- The note in front, its bottom right corner folded. -->
        <path android:pathData="M39,32h40a7,7 0,0 1,7 7v31l-16,16h-31a7,7 0,0 1,-7 -7v-40a7,7 0,0 1,7 -7z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="32"
                    android:startY="32"
                    android:endX="86"
                    android:endY="86">
                    <item android:offset="0" android:color="#FFFFC94D" />
                    <item android:offset="0.5" android:color="#FFF5A623" />
                    <item android:offset="1" android:color="#FFE8710A" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- The folded corner: the note's paler back side. -->
        <path android:pathData="M86,70l-16,16v-11a5,5 0,0 1,5 -5z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="86"
                    android:startY="70"
                    android:endX="74"
                    android:endY="82">
                    <item android:offset="0" android:color="#FFFFE3A3" />
                    <item android:offset="1" android:color="#FFFFC94D" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Two lines of text. -->
        <path
            android:pathData="M43,48H71M43,59H62"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
    </group>
</vector>
