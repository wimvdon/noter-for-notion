<?xml version="1.0" encoding="utf-8"?>
<!-- A sticky note with a 3D edge (like a block) and a folded corner, with a white checkbox.
     Gradient #FFC93C → #F5A623 → #E8731A. See DESIGN.md, "Icons". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled to stay inside the 66dp safe zone of every icon mask. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <!-- The note's thickness, behind it. -->
        <path
            android:fillColor="#B4561A"
            android:pathData="M34,29h46a4,4 0,0 1,4 4v34l-16,16h-34a4,4 0,0 1,-4 -4v-46a4,4 0,0 1,4 -4z" />
        <path android:pathData="M30,24h46a4,4 0,0 1,4 4v34l-16,16h-34a4,4 0,0 1,-4 -4v-46a4,4 0,0 1,4 -4z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="26"
                    android:startY="24"
                    android:endX="80"
                    android:endY="78">
                    <item android:offset="0" android:color="#FFFFC93C" />
                    <item android:offset="0.5" android:color="#FFF5A623" />
                    <item android:offset="1" android:color="#FFE8731A" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Folded corner. -->
        <path
            android:fillColor="#FFC9601A"
            android:pathData="M80,62l-16,16v-12a4,4 0,0 1,4 -4z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M42,36h18a6,6 0,0 1,6 6v18a6,6 0,0 1,-6 6h-18a6,6 0,0 1,-6 -6v-18a6,6 0,0 1,6 -6zM43.5,40.5a3,3 0,0 0,-3 3v15a3,3 0,0 0,3 3h15a3,3 0,0 0,3 -3v-15a3,3 0,0 0,-3 -3z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M44,51l3,-3l3.5,3.5l7,-7l3,3l-10,10z" />
    </group>
</vector>
